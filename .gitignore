# Байткод Python. Раньше он отслеживался, и из-за этого «чистое дерево» было
# недостижимо: любой прогон тестов перезаписывал сотню .pyc, каждый коммит
# тащил бинарный шум, а настоящие правки терялись среди него. Файлы на диске
# нужны и остаются — из-под контроля версий убрано только отслеживание.
__pycache__/
*.py[cod]
*$py.class

# Кэш pytest — то же самое, локальное состояние одной машины.
.pytest_cache/

# Кэш вердиктов валидации. НЕ коммитить: внутри лежит твоя база адресов
# вместе с ответами почтовых серверов.
data/validation_cache.sqlite
data/validation_cache.sqlite-wal
data/validation_cache.sqlite-shm

# Рабочее состояние unlazy: ledger-пайплайны и память Stop-хука. Локальная
# координация одной машины — в репозитории ей делать нечего.
.unlazy/
.unlazy-hook-state.json
.claude/settings.local.json

# Состояние прогона: дедуп, журнал сделанного и очередь повторов. Внутри —
# ключи адресов твоей базы, и это локальное состояние одной машины.
data/run_state.sqlite
data/run_state.sqlite-wal
data/run_state.sqlite-shm

# Откалиброванные веса скоринга: результат ТВОЕЙ рассылки, не общий код.
data/scoring_weights.json

# Временные хранилища таблицы результатов. Создаются на прогон, удаляются
# при закрытии окна; уборка брошенных — в ui/result_store.py.
data/results_*.sqlite*
